import pandas as pd
import logging
import os
from engine.handlers.massey_handler import MasseyHandler
from gsheets import read_sheet_df
from utils import format_date, round_dict_values, convert_bool
from config import (
    RL_BASE_MMR, RL_DATE_COL, RL_MATCH_COL, RL_BLUE_TEAM_COLS, RL_ORANGE_TEAM_COLS,
    RL_BLUE_SCORE_COL, RL_ORANGE_SCORE_COL, RL_OVERTIME_COL, RL_DEACTIVATED_PLAYERS,
    RL_MATRIX_GAMMA, RL_MASSEY_SCALE, RL_MASSEY_GOAL_DIFF_FACTOR, RL_MASSEY_GOAL_DIFF_CAP,
    RL_MASSEY_REGULARIZATION, RL_MASSEY_DECAY, RL_MASSEY_MATCHUP_BALANCE,
    RL_ENGINE_LOG_FILE,
)

UNCERTAINTY = False


def _setup_rl_handler_logger() -> logging.Logger:
    logger = logging.getLogger("rl_engine_handlers")
    if logger.handlers:
        return logger

    os.makedirs(os.path.dirname(RL_ENGINE_LOG_FILE), exist_ok=True)

    logger.setLevel(logging.INFO)
    logger.propagate = False

    file_handler = logging.FileHandler(RL_ENGINE_LOG_FILE, mode="w", encoding="utf-8")
    formatter = logging.Formatter("%(asctime)s | %(levelname)s | %(message)s")
    file_handler.setFormatter(formatter)
    logger.addHandler(file_handler)

    return logger


def get_RL_table(sheet_name):
    # table entry structure:
    # {
    #   "Date": str,
    #   "Match": int,
    #   "Blue Team": [str],
    #   "Orange Team": [str],
    #   "Blue Score": int,
    #   "Orange Score": int,
    #   "Overtime": bool,
    #   "Blue Win Prob.": float,       # win probability before the match
    #   "Orange Win Prob.": float,
    #   "Matrix Blue Prob.": float,    # same values (kept for UI compatibility)
    #   "Matrix Orange Prob.": float,
    #   "Uncertainty Factors": {},     # unused; kept for schema compatibility
    #   "Total Delta": {str: int},     # Massey MMR change for every player
    #   "Total MMR": {str: int},       # Massey MMR for every player after the match
    #   "Matrix MMR": [[float]],       # diagonal = MMR, off-diag = col_mmr - row_mmr
    #   "Matrix Indices": {str: int},
    # }
    table = []
    logger = _setup_rl_handler_logger()
    logger.info("=== RL engine start | sheet=%s ===", sheet_name)

    massey = MasseyHandler(
        base_mmr=RL_BASE_MMR,
        scale=RL_MASSEY_SCALE,
        gamma=RL_MATRIX_GAMMA,
        goal_diff_factor=RL_MASSEY_GOAL_DIFF_FACTOR[sheet_name],
        goal_diff_cap=RL_MASSEY_GOAL_DIFF_CAP[sheet_name],
        regularization=RL_MASSEY_REGULARIZATION,
        decay=RL_MASSEY_DECAY,
    )

    for _, rows in read_sheet_df(sheet_name).iterrows():
        date_val = pd.to_datetime(rows[RL_DATE_COL])
        date_str = format_date(date_val)
        match_num = int(rows[RL_MATCH_COL])
        blue_team = [p for p in rows[RL_BLUE_TEAM_COLS] if pd.notna(p)]
        orange_team = [p for p in rows[RL_ORANGE_TEAM_COLS] if pd.notna(p)]
        blue_score = rows[RL_BLUE_SCORE_COL]
        orange_score = rows[RL_ORANGE_SCORE_COL]
        overtime = convert_bool(rows[RL_OVERTIME_COL])

        if any(player in RL_DEACTIVATED_PLAYERS for player in blue_team + orange_team):
            continue

        logger.info(
            "MATCH_START | date=%s | match=%s | blue=%s | orange=%s | score=%s-%s | overtime=%s",
            date_str, match_num, blue_team, orange_team, blue_score, orange_score, overtime,
        )

        # Win probability computed from ratings BEFORE adding this match
        prob_blue, prob_orange = massey.predict_win_prob(blue_team, orange_team)
        prev_ratings = massey.get_ratings()

        # Incorporate match and recompute all ratings from scratch
        massey.add_match_and_recompute(blue_team, orange_team, blue_score, orange_score, overtime)
        curr_ratings = massey.get_ratings()

        # Delta for every player whose rating exists (recompute touches all)
        total_delta = {
            p: curr_ratings.get(p, RL_BASE_MMR) - prev_ratings.get(p, RL_BASE_MMR)
            for p in curr_ratings
        }

        matrix, indices = massey.build_matrix()

        logger.info(
            "MATCH_END | total_mmr=%s",
            {k: round(v, 1) for k, v in sorted(curr_ratings.items())},
        )

        table.append({
            "Date": date_str,
            "Match": match_num,
            "Blue Team": blue_team,
            "Orange Team": orange_team,
            "Blue Score": blue_score,
            "Orange Score": orange_score,
            "Overtime": overtime,
            "Blue Win Prob.": round(prob_blue, 2),
            "Orange Win Prob.": round(prob_orange, 2),
            "Matrix Blue Prob.": prob_blue,
            "Matrix Orange Prob.": prob_orange,
            "Uncertainty Factors": {},
            "Total Delta": round_dict_values(total_delta),
            "Total MMR": round_dict_values(curr_ratings),
            "Matrix MMR": [row[:] for row in matrix],
            "Matrix Indices": indices,
        })

    logger.info("=== RL engine end | sheet=%s | matches=%s ===", sheet_name, len(table))
    return table
